[submodule "nasoq"]
	path = nasoq
	# Temporarily pointed at alecjacobson's fork/branch, which fixes a
	# 64-bit/32-bit integer ABI mismatch between vendored CLAPACK and
	# OpenBLAS that made NASOQ_USE_CLAPACK=ON + NASOQ_BLAS_BACKEND=OpenBLAS
	# (used on Apple Silicon, where there's no Intel MKL) return NaN on
	# every solve. See https://github.com/sympiler/nasoq/pull/34; repoint
	# back to https://github.com/sympiler/nasoq.git once that merges.
	#
	# NOTE: a separate attempt to switch this project to
	# NASOQ_BLAS_BACKEND=Accelerate (see
	# https://github.com/sympiler/nasoq/pull/35, which fixes a real,
	# root-caused bug -- a void-vs-int LAPACK return-value mismatch in
	# `nasoq::clapacke::LAPACKE_dlapmt` -- behind the nondeterminism
	# originally reported in the unmerged
	# https://github.com/sympiler/nasoq/pull/27) was evaluated and NOT
	# adopted here: even with that fix, NASOQ LBL via Accelerate showed a
	# separate, still-unresolved scale-dependent problem on the indefinite
	# "Mixed Biharmonic"/"Mixed Triharmonic" systems -- backward error grew
	# with problem size (~1.4e-6 at a 400x400 grid, ~1.4e-5 at 800x800) and
	# the full xyzrgb_dragon-720K.ply Mixed Biharmonic case hung for over
	# 15 minutes (vs. 3.7s with OpenBLAS) instead of completing. This looks
	# like a distinct bug in Accelerate's Bunch-Kaufman pivoting or
	# supernodal blocking at scale, not investigated further here. OpenBLAS
	# remains this project's NASOQ backend on Apple Silicon.
	url = https://github.com/alecjacobson/nasoq.git
[submodule "ma57"]
	path = ma57
	url = https://github.com/alecjacobson/ma57
